# Copy to ".env" and fill in. docker compose reads this automatically.

# ── Umami analytics ─────────────────────────────────────────
# Strong values for the analytics database + app secret (change these!).
UMAMI_DB_PASSWORD=change-me-to-something-strong
UMAMI_APP_SECRET=change-me-to-a-long-random-string

# Filled in AFTER the first deploy: open https://analytics.<your-domain>,
# log in (default admin / umami — change it immediately), add a website, then
# copy its tracking-script URL and Website ID here and rebuild the frontend.
# Leave UMAMI_WEBSITE_ID blank to ship with no analytics snippet at all.
UMAMI_SCRIPT_URL=https://analytics.sirsavings.com/script.js
UMAMI_WEBSITE_ID=
